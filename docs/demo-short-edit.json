  "paragraphs": [
    {
      "id": "intro",
      "text": "WorldForge brings warehouse design, route planning and mobile robot simulation into one web workspace.",
      "start": 0.0,
      "end": 6.5059375
    },
    {
      "id": "prompt",
      "text": "Start by describing the environment you want to build. For example, a twenty by thirty metre warehouse with storage racks and obstacles.",
      "start": 6.5059375,
      "end": 14.2390625
    },
    {
      "id": "connection",
      "text": "Connect your own OpenAI API key for AI-assisted building and editing. For this walkthrough, we'll open an existing Astra-authored sample warehouse.",
      "pause_after_seconds": 1,
      "start": 14.2390625,
      "end": 24.102270833333332
    },
    {
      "id": "robot",
      "text": "Explore the layout, then choose the robot you want to test. The clearance overlay shows the space it needs around obstacles.",
      "start": 24.102270833333332,
      "end": 33.102291666666666
    },
    {
      "id": "mission",
      "text": "Set a start and destination directly in the scene, and plan a route through the warehouse.",
      "start": 33.102291666666666,
      "end": 41.102270833333336
    },
    {
      "id": "edit",
      "text": "Adjust a rack's dimensions, apply the edit, and plan again to see how the layout changes the route.",
      "pause_after_seconds": 1,
      "start": 41.102270833333336,
      "end": 49.102270833333336
    },
    {
      "id": "run",
      "text": "Now run the mission using planar MuJoCo physics.",
      "pause_after_seconds": 1,
      "start": 49.102270833333336,
      "end": 55.102291666666666
    },
    {
      "id": "results",
      "text": "Follow the robot through the warehouse, then inspect the outcome. Review time, distance, contacts and clearance, and replay the journey from different angles.",
      "start": 55.102291666666666,
      "end": 68.10229166666667
    },
    {
      "id": "closing",
      "text": "WorldForge helps you explore warehouse layouts and test robot missions before moving to a physical setup.",
      "start": 68.10229166666667,
      "end": 74.2405
    }
  ],
